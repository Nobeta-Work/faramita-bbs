# 后端 java 程序所需环境变量列表
# 复制此文件为 .env 并填入真实值：
#   cp docker/backend/.env.example docker/backend/.env
#
# 注意：全栈 compose 中 backend/mysql/redis 在桥接网络内，通过服务名互访

# 更推荐在 application 系列文件中设置环境变量

# ===== Spring =====
SPRING_PROFILES_ACTIVE=dev

# ===== MySQL =====
FARAMITA_DATASOURCE_URL=jdbc:mysql://mysql:3306/faramita_bbs?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
FARAMITA_DATASOURCE_USERNAME=root
FARAMITA_DATASOURCE_PASSWORD=change_me

# ===== Redis =====
FARAMITA_REDIS_HOST=redis
FARAMITA_REDIS_PORT=6379
FARAMITA_REDIS_PASSWORD=
FARAMITA_REDIS_DATABASE=0
FARAMITA_REDIS_CONNECT_TIMEOUT=3000ms
FARAMITA_REDIS_TIMEOUT=3000ms
FARAMITA_REDIS_LETTUCE_POOL_MAX_ACTIVE=16
FARAMITA_REDIS_LETTUCE_POOL_MAX_IDLE=8
FARAMITA_REDIS_LETTUCE_POOL_MIN_IDLE=4
FARAMITA_REDIS_LETTUCE_POOL_MAX_WAIT=1000ms

# ===== JWT =====
FARAMITA_JWT_SECRET=change_me_to_a_256bit_key_for_hmac_sha256
FARAMITA_JWT_ACCESS_TOKEN_EXPIRE=864000000
FARAMITA_JWT_REFRESH_TOKEN_EXPIRE=864000000

# ===== Github =====
FARAMITA_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ===== 文件存储 =====
FARAMITA_FILE_AVATAR_ROOT_PATH=/data/faramita-bbs/avatar
FARAMITA_FILE_AVATAR_MAX_SIZE=10485760
FARAMITA_FILE_AVATAR_EXPIRE=2
FARAMITA_FILE_IMAGE_MAX_SIZE=15728640

# ===== MySQL/Redis 容器密码 (全栈 compose 使用) =====
MYSQL_ROOT_PASSWORD=change_me
REDIS_PASSWORD=