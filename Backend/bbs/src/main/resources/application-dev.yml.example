para:
  jwt:
    secret: thisIsASecure256BitKeyForHmacSha256Algorithm
    access-token-expire: 864000000 # 10天
    refresh-token-expire: 864000000 # 10天
  file:
    avatar:
      root-path: D:/Education/Project/Para BBS/Backend/resources/data/
      max-size: 10485760  # 最大上传10MB
      expire: 2  # 过期时间2h
    image:
      max-size: 15728640  # 最大上传15MB
  github:
    token: YOUR_GITHUB_TOKEN_HERE
  datasource:
    url: jdbc:mysql://localhost:3306/para_bbs?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: root
    password: 123456
  redis:
    host: 127.0.0.1
    port: 6379
    password: 
    database: 0
    # 连接超时
    connect-timeout: 3000ms
    # 命令执行超时
    timeout: 3000ms

    # Lettuce 配置
    lettuce:
      pool:
        max-active: 16 # 最大连接数
        max-idle: 8 # 最大空闲连接
        min-idle: 4 # 最小空闲连接
        max-wait: 1000ms # 最大等待时间，超时报错

springdoc:
  api-docs:
    enabled: false
  swagger-ui:
    enabled: false
