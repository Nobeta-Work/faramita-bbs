<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.nobeta.bbs.module.agent.mapper.AgentMapper">

    <sql id="AgentColumns">
        token,
        userId,
        name,
        expire,
        create_time,
        update_time,
        is_deleted
    </sql>


    <!-- selectAgentTokenPage --> 

    <select id="selectAgentTokenPage">
        SELECT
            <include refid="AgentColumns"></include>
        FROM agent_token
        ORDER BY
            <choose>
                <when test="sortField == 'updateTime'">
                    update_time
                </when>
                <otherwise>
                    create_time
                </otherwise>
            </choose>
            
            <choose>
                <when test="sortOrder != null and sortOrder.toLowerCase() == 'asc'">
                    ASC
                </when>
                <otherwise>
                    DESC
                </otherwise>
            </choose>
    </select>

    <!-- insertAgent --> 

    <insert id="insertAgent">
        INSERT INTO agent_token (
            token, user_id, name, expire
        ) VALUES (
            #{token}, #{user_id}, #{name}, #{expire}
        )
    </insert>
</mapper>